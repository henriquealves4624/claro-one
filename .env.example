GROQ_API_KEY=SEU_TOKEN_AQUI
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_CONTEXT_MODEL=openai/gpt-oss-20b
CCE_TTL_HOURS=2
DEMO_FALLBACK=false
MAX_UPLOAD_MB=25
# Verificacao por SMS: "simulado" (padrao, sem custo) ou "twilio" (conta propria).
SMS_PROVIDER=simulado
# Usados apenas com SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TEST_DESTINATION=
# Validade do acesso do cliente ao canal, em minutos
CHANNEL_ACCESS_MINUTES=30
# Premissa da estimativa de tempo poupado por triagem evitada, em minutos
TRIAGE_MINUTES_ESTIMATE=2
